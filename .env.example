# Copy to .env.local. Never commit .env.local.

# Postgres. For local Docker (npm run db:up) use this exact value:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
# Set to true for hosted databases that require TLS (Neon, Aiven, Supabase, Render...).
DATABASE_SSL=false

# Long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# AI providers: need at least one. Missing keys are skipped. Order = fallback order.
LLM_PROVIDER_ORDER=gemini,groq,openrouter
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free
